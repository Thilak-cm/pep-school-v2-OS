{
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-master-push.sh",
            "statusMessage": "Checking push target..."
          }
        ]
      }
    ]
  }
}
